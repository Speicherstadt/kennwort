{
  "name": "kennwort",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run i18n",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./packages/ui/src/paraglide --strategy localStorage preferredLanguage baseLocale --silent",
    "typecheck": "tsc -b",
    "lint": "biome check --error-on-warnings . && bun scripts/check-dependencies.ts",
    "format": "biome check --write .",
    "test": "vitest run && bun run --cwd apps/server test",
    "build": "bun scripts/build-all.ts",
    "e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "mutation": "bun run --cwd packages/crypto mutation && bun run --cwd packages/core mutation"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@playwright/test": "1.65.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/libsodium-wrappers-sumo": "0.7.8",
    "fast-check": "4.10.3",
    "happy-dom": "21.0.4",
    "libsodium-wrappers-sumo": "0.8.4",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "minimatch": "11.0.9",
    "qs": "6.17.1",
    "esbuild": "0.28.2"
  }
}
