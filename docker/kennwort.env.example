# Settings for docker/compose.yaml and the Quadlet units (docs/installation.md); copy to .env (Compose)
# or /etc/kennwort/kennwort.env (Quadlet) and keep it readable for root only. Every setting is
# described in docs/installation.md; only these are needed.

# The host name people open; Caddy gets its certificate for it
KENNWORT_DOMAIN=kennwort.example.de
# Quadlet only (Compose sets it from KENNWORT_DOMAIN)
KENNWORT_PUBLIC_URL=https://kennwort.example.de
KENNWORT_BEHIND_PROXY=true

# Signs sessions: at least 32 random characters, made once, e.g. with `openssl rand -base64 48`
KENNWORT_AUTH_SECRET=

# Lets the first owner create the company; at least 16 characters. The server does not start while
# it is empty: fill it in for the first start, then delete the line.
KENNWORT_SETUP_CODE=

# The update notice asks GitHub once a day for the newest release; "false" turns it off
# KENNWORT_UPDATE_CHECK=false
