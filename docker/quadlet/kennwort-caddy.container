# Caddy in front of Kennwort as a Podman Quadlet unit (K-703, docs/installation.md), with the same
# docker/Caddyfile as Compose; copy it to /etc/kennwort/Caddyfile.
[Unit]
Description=Caddy for Kennwort
Requires=kennwort.service
After=kennwort.service

[Container]
ContainerName=kennwort-caddy
Image=docker.io/library/caddy:2.10
EnvironmentFile=/etc/kennwort/kennwort.env
Network=kennwort.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=/etc/kennwort/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=kennwort-caddy-data.volume:/data
Volume=kennwort-caddy-config.volume:/config
ReadOnly=true
ReadOnlyTmpfs=true
DropCapability=all
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
