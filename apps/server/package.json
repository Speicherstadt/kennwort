{
  "name": "@kennwort/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build --compile --minify src/main.ts --outfile dist/kennwort-server",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "load": "bun scripts/load.ts",
    "db:generate": "drizzle-kit generate && bun scripts/embed-migrations.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.26",
    "better-auth": "1.7.26",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "zod": "4.6.7",
    "@kennwort/crypto": "workspace:*",
    "@kennwort/core": "workspace:*"
  },
  "devDependencies": {
    "@simplewebauthn/server": "14.1.0",
    "drizzle-kit": "0.31.11"
  }
}
